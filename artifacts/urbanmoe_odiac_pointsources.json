{
 "question": "do the worst carbon-residual tiles contain or adjoin the point-source cells visible in the ODIAC raster the label was built from?",
 "why_this_upgrades_4_13": "The plant-proximity test uses WRI plants as a proxy for what ODIAC injected. Detecting the spikes in ODIAC itself removes the proxy from the chain, so the claim becomes a statement about the label's structure.",
 "odiac_year": 2015,
 "odiac_version": "v2024",
 "year_provenance": "given on the command line",
 "why_the_year_choice_does_not_matter": "urbanmoe_odiac_vintage.json shows R2 flat to three decimals across 2012-2022 in every city, and version_invariance below re-runs this detection under every available ODIAC version with the same outcome. The year is arbitrary and stated as such.",
 "detection_rule": {
  "statistic": "cell value divided by the median of the ring of cells 2..4 cells away (Chebyshev), core excluded",
  "why_a_ring": "ODIAC's non-point term is nightlight-downscaled and smooth at 1 km; an injected point source is not. The hole keeps a source out of its own background estimate.",
  "edge_handling": "padded with NaN and a nanmedian taken, so edge cells use real neighbours only",
  "excluded": "cells with a zero or undefined ring background are not testable and are counted separately rather than flagged",
  "threshold": "headline 20.0; every result swept over [5.0, 10.0, 20.0, 50.0, 100.0]"
 },
