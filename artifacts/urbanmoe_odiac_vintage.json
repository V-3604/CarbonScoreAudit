{
 "question": "which ODIAC year and version is the benchmark's c_value?",
 "why": "UrbanMoE does not state the label vintage; section 2c concedes it as an unresolvable limitation. Rebuilding the label from published rasters resolves it by measurement.",
 "source": "ODIAC 1 km monthly GeoTIFF via the US Greenhouse Gas Center raster API (earth.gov, CC-BY-4.0). Verified bit-for-bit against the NIES original odiac2024_1km_excl_intl_1812.tif.gz over the Beijing envelope on 2026-08-11; the mirror's -9999 marks cells NIES stores as 0.0.",
 "method": {
  "units": "tonne carbon per 1 km cell per month; a year is the sum of its 12 files",
  "aggregation": "area-weighted sum onto the benchmark's 2 km tiles: each ODIAC cell contributes the fraction of its own area inside the tile, which assumes emissions are uniform within a cell",
  "crs": "EPSG:4326 throughout; overlap fractions computed in degrees, where the cos(latitude) factor cancels within a cell. No distances are used.",
  "cell_geometry": "ODIAC's grid is 1/120 degree square, nominally 1 km at the equator only; at Beijing's latitude a cell is about 0.92 km north-south and 0.71 km east-west, so a 2 km tile spans about 6.3 cells, not 4. Weights are verified to sum to tile_area/cell_area exactly.",
  "nodata_rule": "mask band 0 -> value 0 (verified against NIES, not assumed)",
  "fit": "ordinary least squares of c_value on the aggregated ODIAC value, per city",
  "determinism": "no stochastic component; the result is exactly reproducible"
 },
